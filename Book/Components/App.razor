<!DOCTYPE html>
<html lang="zh-Hant">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="_content/BootstrapBlazor/css/bootstrap.blazor.bundle.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Book.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="NoPrerender" />
</head>

<body>
    <Routes @rendermode="NoPrerender" />
    <ReconnectModal />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/BootstrapBlazor/js/bootstrap.blazor.bundle.min.js"></script>
</body>

</html>

@code {
    // 假登入狀態存在連線內，關閉預先轉譯避免狀態在預轉譯/互動之間遺失
    private static readonly IComponentRenderMode NoPrerender = new InteractiveServerRenderMode(prerender: false);
}
