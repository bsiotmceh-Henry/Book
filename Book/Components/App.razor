<!DOCTYPE html>
<html lang="zh-Hant">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="_content/BootstrapBlazor/css/bootstrap.blazor.bundle.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Book.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/BootstrapBlazor/js/bootstrap.blazor.bundle.min.js"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // 互動頁面：關閉預先轉譯（驗證狀態取自 Cookie，由連線建立時讀取）
    private static readonly IComponentRenderMode NoPrerender = new InteractiveServerRenderMode(prerender: false);

    // 標記 [ExcludeFromInteractiveRouting] 的頁面（登入）以靜態 SSR 轉譯，才能在回應中寫入 Cookie
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? NoPrerender : null;
}
