@page "/user-manage"
@attribute [Authorize(Roles = Roles.Admin)]
@using System.ComponentModel.DataAnnotations
@inject UserService Users

<PageTitle>使用者管理</PageTitle>

<FlashMessage @bind-Result="flash" />

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr><th>帳號</th><th>顯示名稱</th><th>角色</th><th class="text-end">操作</th></tr>
        </thead>
        <tbody>
            @foreach (var u in users)
            {
                <tr>
                    <td>@u.UserName</td>
                    <td>@u.DisplayName</td>
                    <td><span class="badge @(u.Role == Roles.Admin ? "text-bg-dark" : "text-bg-secondary")">@Roles.Label(u.Role)</span></td>
                    <td class="text-end text-nowrap">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => OpenEdit(u)">編輯</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => AskDelete(u)">刪除</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<p class="text-muted small">新使用者由使用者自行註冊，管理員不另提供新增使用者。</p>

@* A6 編輯使用者（BootstrapBlazor Modal） *@
<Modal @ref="editModal" OnCloseAsync="OnEditClosed">
    <ModalDialog Title="編輯使用者" IsCentered="true" Size="Size.Medium" ShowFooter="true" ShowCloseButton="false" ShowSaveButton="false">
        <BodyTemplate>
            @if (editing != null)
            {
                <EditForm id="edit-user-form" Model="editing" OnValidSubmit="SaveEdit" FormName="edit-user">
                    <DataAnnotationsValidator />

                    <label class="form-label small text-muted mb-1">帳號</label>
                    <input class="form-control mb-2" value="@editing.UserName" readonly disabled />

                    <label class="form-label small text-muted mb-1">顯示名稱</label>
                    <InputText class="form-control" @bind-Value="editing.DisplayName" />
                    <ValidationMessage For="() => editing.DisplayName" />

                    <label class="form-label small text-muted mb-1 mt-2">角色</label>
                    <InputSelect class="form-select" @bind-Value="editing.Role">
                        <option value="@Roles.Admin">管理員</option>
                        <option value="@Roles.User">一般使用者</option>
                    </InputSelect>

                    <label class="form-label small text-muted mb-1 mt-2">重設密碼（不改請留空）</label>
                    <InputText type="password" class="form-control" @bind-Value="editing.NewPassword" autocomplete="new-password" />

                    @if (modalError != null)
                    {
                        <div class="alert alert-danger py-2 mt-3 mb-0">@modalError</div>
                    }
                </EditForm>
            }
        </BodyTemplate>
        <FooterTemplate>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseEdit">取消</button>
            <button type="submit" form="edit-user-form" class="btn btn-dark btn-sm">儲存</button>
        </FooterTemplate>
    </ModalDialog>
</Modal>

<ConfirmModal Show="deleting != null" Name="@(deleting?.DisplayName ?? "")"
              OnCancel="() => deleting = null" OnConfirm="ConfirmDelete" />

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>目前登入者的使用者 Id（來自 Cookie 身分）。</summary>
    private async Task<string> CurrentUserId() => (await AuthState).User.UserId();

    private List<AppUser> users = new();
    private EditUserModel? editing;
    private Modal? editModal;
    private AppUser? deleting;
    private string? modalError;
    private Result? flash;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => users = await Users.GetUsersAsync();

    private async Task OpenEdit(AppUser u)
    {
        modalError = null;
        editing = new() { Id = u.Id, UserName = u.UserName, DisplayName = u.DisplayName, Role = u.Role };
        await editModal!.Show();
    }

    private async Task CloseEdit() => await editModal!.Close();

    // Modal 關閉（取消 / X / Esc / 點背景）後清掉編輯狀態
    private Task OnEditClosed()
    {
        editing = null;
        return Task.CompletedTask;
    }

    private async Task SaveEdit()
    {
        var e = editing!;
        if (!string.IsNullOrEmpty(e.NewPassword) &&
            (e.NewPassword.Length < 8 || !System.Text.RegularExpressions.Regex.IsMatch(e.NewPassword, "^(?=.*[A-Za-z])(?=.*\\d).*$")))
        {
            modalError = "密碼至少 8 碼，且須包含英文字母與數字";
            return;
        }
        var r = await Users.UpdateUserAsync(e.Id, e.DisplayName, e.Role, e.NewPassword, await CurrentUserId());
        if (!r.Success) { modalError = r.Message; return; }
        flash = r;
        await editModal!.Close();
        await Load();
    }

    private void AskDelete(AppUser u) => deleting = u;

    private async Task ConfirmDelete()
    {
        flash = await Users.DeleteUserAsync(deleting!.Id, await CurrentUserId());
        deleting = null;
        await Load();
    }

    private class EditUserModel
    {
        public string Id { get; set; } = "";
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "請輸入顯示名稱")]
        [StringLength(100, ErrorMessage = "顯示名稱最長 100 字元")]
        public string DisplayName { get; set; } = "";

        public string Role { get; set; } = Roles.User;

        /// <summary>空白表示不變更；有輸入則依密碼規則驗證（於 SaveEdit 檢查）。</summary>
        public string? NewPassword { get; set; }
    }
}
