@page "/book-manage"
@attribute [Authorize(Roles = Roles.Admin)]
@using System.ComponentModel.DataAnnotations
@inject BookService Books

<PageTitle>書籍管理</PageTitle>

<FlashMessage @bind-Result="flash" />

<form class="row g-2 mb-3" @onsubmit="Search" @onsubmit:preventDefault>
    <div class="col">
        <input class="form-control" placeholder="書名 / 作者 / 出版社" @bind="keyword" @bind:event="oninput" />
    </div>
    <div class="col-auto">
        <select class="form-select" @bind="categoryId">
            <option value="0">全部分類</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-auto d-flex gap-2">
        <button type="submit" class="btn btn-outline-dark">查詢</button>
        <button type="button" class="btn btn-outline-dark" @onclick="OpenAdd">新增書籍</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr><th>書名</th><th>作者</th><th>出版社</th><th>分類</th><th>數量</th><th class="text-end">操作</th></tr>
        </thead>
        <tbody>
            @foreach (var b in items)
            {
                <tr>
                    <td>@b.Title</td>
                    <td>@b.Author</td>
                    <td>@b.Publisher</td>
                    <td>@b.Category?.Name</td>
                    <td>@b.Quantity</td>
                    <td class="text-end text-nowrap">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => OpenEdit(b)">編輯</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => AskDelete(b)">刪除</button>
                    </td>
                </tr>
            }
            @if (items.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">查無符合的書籍</td></tr>
            }
        </tbody>
    </table>
</div>

<Pager Page="page" Total="total" PageChanged="GoPage" />

@* A2 新增 / 編輯書籍（BootstrapBlazor Modal，編輯時帶入原資料） *@
<Modal @ref="formModal" OnCloseAsync="OnFormClosed">
    <ModalDialog Title="@(form?.Id == 0 ? "新增書籍" : "編輯書籍")" IsCentered="true" Size="Size.Medium" ShowFooter="true" ShowCloseButton="false" ShowSaveButton="false">
        <BodyTemplate>
            @if (form != null)
            {
                <EditForm id="book-form" Model="form" OnValidSubmit="Save" FormName="book-form">
                    <DataAnnotationsValidator />

                    <label class="form-label small text-muted mb-1">書名</label>
                    <InputText class="form-control" @bind-Value="form.Title" />
                    <ValidationMessage For="() => form.Title" />

                    <label class="form-label small text-muted mb-1 mt-2">作者</label>
                    <InputText class="form-control" @bind-Value="form.Author" />
                    <ValidationMessage For="() => form.Author" />

                    <label class="form-label small text-muted mb-1 mt-2">出版社</label>
                    <InputText class="form-control" @bind-Value="form.Publisher" />
                    <ValidationMessage For="() => form.Publisher" />

                    <label class="form-label small text-muted mb-1 mt-2">分類</label>
                    <InputSelect class="form-select" @bind-Value="form.CategoryId">
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => form.CategoryId" />

                    <label class="form-label small text-muted mb-1 mt-2">數量</label>
                    <InputNumber class="form-control" @bind-Value="form.Quantity" />
                    <ValidationMessage For="() => form.Quantity" />
                </EditForm>
            }
        </BodyTemplate>
        <FooterTemplate>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseForm">取消</button>
            <button type="submit" form="book-form" class="btn btn-dark btn-sm">儲存</button>
        </FooterTemplate>
    </ModalDialog>
</Modal>

<ConfirmModal Show="deleting != null" Name="@(deleting?.Title ?? "")"
              OnCancel="() => deleting = null" OnConfirm="ConfirmDelete" />

@code {
    private List<Category> categories = new();
    private List<BookItem> items = new();
    private string keyword = "";
    private int categoryId;
    private string appliedKeyword = "";
    private int appliedCategoryId;
    private int page = 1, total;
    private BookForm? form;
    private Modal? formModal;
    private BookItem? deleting;
    private Result? flash;

    protected override async Task OnInitializedAsync()
    {
        categories = await Books.GetCategoriesAsync();
        await Load();
    }

    private async Task Load() => (items, total) = await Books.SearchBooksAsync(appliedKeyword, appliedCategoryId, page);

    private async Task Search()
    {
        appliedKeyword = keyword;
        appliedCategoryId = categoryId;
        page = 1;
        await Load();
    }

    private async Task GoPage(int p) { page = p; await Load(); }

    // 新增時數量預設 1，分類預設第一個
    private async Task OpenAdd()
    {
        form = new() { CategoryId = categories.FirstOrDefault()?.Id ?? 0, Quantity = 1 };
        await formModal!.Show();
    }

    private async Task OpenEdit(BookItem b)
    {
        form = new()
        {
            Id = b.Id, Title = b.Title, Author = b.Author, Publisher = b.Publisher,
            CategoryId = b.CategoryId, Quantity = b.Quantity,
        };
        await formModal!.Show();
    }

    private async Task CloseForm() => await formModal!.Close();

    // Modal 關閉（取消 / X / Esc / 點背景）後清掉表單狀態
    private Task OnFormClosed()
    {
        form = null;
        return Task.CompletedTask;
    }

    private async Task Save()
    {
        var f = form!;
        flash = await Books.SaveBookAsync(new BookItem
        {
            Id = f.Id, Title = f.Title.Trim(), Author = f.Author.Trim(), Publisher = f.Publisher.Trim(),
            CategoryId = f.CategoryId, Quantity = f.Quantity,
        });
        await formModal!.Close();
        await Load();
    }

    private void AskDelete(BookItem b) => deleting = b;

    private async Task ConfirmDelete()
    {
        flash = await Books.DeleteBookAsync(deleting!.Id);
        deleting = null;
        await Load();
    }

    private class BookForm
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "請輸入書名")]
        [StringLength(200, ErrorMessage = "書名最長 200 字元")]
        public string Title { get; set; } = "";

        [Required(ErrorMessage = "請輸入作者")]
        [StringLength(100, ErrorMessage = "作者最長 100 字元")]
        public string Author { get; set; } = "";

        [Required(ErrorMessage = "請輸入出版社")]
        [StringLength(100, ErrorMessage = "出版社最長 100 字元")]
        public string Publisher { get; set; } = "";

        [Range(1, int.MaxValue, ErrorMessage = "請選擇分類")]
        public int CategoryId { get; set; }

        [Range(0, int.MaxValue, ErrorMessage = "數量須為大於或等於 0 的整數")]
        public int Quantity { get; set; }
    }
}
