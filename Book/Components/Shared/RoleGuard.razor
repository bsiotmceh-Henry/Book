@inject SessionState Session
@inject NavigationManager Nav

@* 未登入→導向 /login；已登入但角色不符→顯示「無權限存取」 *@
@if (Session.IsLoggedIn)
{
    @if (Session.User!.Role == Role)
    {
        @ChildContent
    }
    else
    {
        <div class="text-center py-5">
            <h4>無權限存取</h4>
            <p class="text-muted">您的角色無法使用此頁面。</p>
            <a class="btn btn-outline-secondary btn-sm" href="@Session.HomePath">回到首頁</a>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public string Role { get; set; } = Roles.User;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        if (!Session.IsLoggedIn) Nav.NavigateTo("/login");
    }
}
