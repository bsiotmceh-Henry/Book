@* 分頁元件：包裝 BootstrapBlazor 的 Pagination，維持原本 Page / Total / PageChanged 介面，呼叫端不用改 *@
@if (TotalPages > 1)
{
    <div class="mt-3">
        <Pagination PageIndex="Page"
                    PageCount="TotalPages"
                    PrevPageIcon="bi bi-chevron-left"
                    NextPageIcon="bi bi-chevron-right"
                    PrevEllipsisPageIcon="bi bi-chevron-double-left"
                    NextEllipsisPageIcon="bi bi-chevron-double-right"
                    PageInfoText="@($"共 {Total} 筆，第 {Page} / {TotalPages} 頁")"
                    OnPageLinkClick="Go" />
    </div>
}
else if (Total > 0)
{
    <small class="text-muted d-block mt-3">共 @Total 筆</small>
}

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int Total { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    // 總頁數：依固定每頁筆數換算
    private int TotalPages => (int)Math.Ceiling(Total / (double)BorrowRules.PageSize);

    // 頁碼點擊：超出範圍忽略，否則通知父層換頁
    private Task Go(int p) => p < 1 || p > TotalPages ? Task.CompletedTask : PageChanged.InvokeAsync(p);
}
